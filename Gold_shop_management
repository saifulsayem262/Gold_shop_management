#include <stdio.h>
#include <string.h>

struct GoldItem {
    int id;
    char name[50];
    float weight; // in grams
    float pricePerGram;
    int quantity;
};

void addItem(struct GoldItem items[], int *count);
void displayItems(struct GoldItem items[], int count);
void searchItem(struct GoldItem items[], int count);
void calculateBill(struct GoldItem items[], int count);

int main() {
    struct GoldItem items[100];
    int count = 0;
    int choice;

    do {
        printf("\n=== Gold Store Management System ===\n");
        printf("1. Add Gold Item\n");
        printf("2. Display All Items\n");
        printf("3. Search Item by ID\n");
        printf("4. Calculate Bill / Sell\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addItem(items, &count);
                break;
            case 2:
                displayItems(items, count);
                break;
            case 3:
                searchItem(items, count);
                break;
            case 4:
                calculateBill(items, count);
                break;
            case 5:
                printf("Exiting program. Thank you!\n");
                break;
            default:
                printf("Invalid choice! Please try again.\n");
        }
    } while (choice != 5);

    return 0;
}

void addItem(struct GoldItem items[], int *count) {
    printf("\nEnter Item ID: ");
    scanf("%d", &items[*count].id);
    printf("Enter Item Name (e.g., Ring/Necklace): ");
    scanf("%s", items[*count].name);
    printf("Enter Weight (grams): ");
    scanf("%f", &items[*count].weight);
    printf("Enter Price per Gram (BDT): ");
    scanf("%f", &items[*count].pricePerGram);
    printf("Enter Quantity: ");
    scanf("%d", &items[*count].quantity);

    (*count)++;
    printf("Item added successfully!\n");
}

void displayItems(struct GoldItem items[], int count) {
    if (count == 0) {
        printf("\nNo items in inventory.\n");
        return;
    }

    printf("\n--- Inventory List ---\n");
    printf("%-5s %-15s %-10s %-15s %-10s\n", "ID", "Name", "Weight(g)", "Price/g(BDT)", "Qty");
    for (int i = 0; i < count; i++) {
        printf("%-5d %-15s %-10.2f %-15.2f %-10d\n",
            items[i].id, items[i].name, items[i].weight, items[i].pricePerGram, items[i].quantity);
    }
}

void searchItem(struct GoldItem items[], int count) {
    int targetId, found = 0;
    printf("\nEnter Item ID to search: ");
    scanf("%d", &targetId);

    for (int i = 0; i < count; i++) {
        if (items[i].id == targetId) {
            printf("\nItem Found:\n");
            printf("ID: %d\nName: %s\nWeight: %.2f g\nPrice/g: %.2f BDT\nQuantity: %d\n",
                items[i].id, items[i].name, items[i].weight, items[i].pricePerGram, items[i].quantity);
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Item with ID %d not found.\n", targetId);
    }
}

void calculateBill(struct GoldItem items[], int count) {
    int targetId, qty, found = 0;
    printf("\nEnter Item ID to buy/sell: ");
    scanf("%d", &targetId);

    for (int i = 0; i < count; i++) {
        if (items[i].id == targetId) {
            found = 1;
            printf("Enter quantity to purchase: ");
            scanf("%d", &qty);

            if (qty > items[i].quantity) {
                printf("Error: Only %d left in stock!\n", items[i].quantity);
            } else {
                float totalBasePrice = items[i].weight * items[i].pricePerGram * qty;
                float makingCharge = totalBasePrice * 0.10; // 10% making charge
                float grandTotal = totalBasePrice + makingCharge;

                printf("\n--- BILL RECEIPT ---\n");
                printf("Item: %s x %d\n", items[i].name, qty);
                printf("Total Weight: %.2f g\n", items[i].weight * qty);
                printf("Base Price: %.2f BDT\n", totalBasePrice);
                printf("Making Charges (10%): %.2f BDT\n", makingCharge);
                printf("Grand Total: %.2f BDT\n", grandTotal);

                // Update stock
                items[i].quantity -= qty;
            }
            break;
        }
    }
    if (!found) {
        printf("Item ID not found.\n");
    }
}
